                  "    ",
                  "    // Якщо body містить реальний email (не змінну) - не перезаписуємо",
                  "    if (currentBody.email && ",
                  "        currentBody.email !== '{{uniqueEmail}}' && ",
                  "        !currentBody.email.includes('{{')) {",
                  "        // Користувач вручну вказав email, нічого не міняємо",
                  "        return;",
                  "    }",
                  "    ",
                  "    // Якщо є збережений uniqueEmail - використовуємо його",
                  "    const uniqueEmail = pm.environment.get('uniqueEmail');",
                  "    if (uniqueEmail) {",
                  "        const requestBody = {",
                  "            email: uniqueEmail,",
                  "            password: \"goit2025\"",
                  "        };",
                  "        pm.request.body.raw = JSON.stringify(requestBody, null, 2);",
                  "    }",
                  "} catch (e) {",
                  "    // Помилка парсингу - нічого не робимо",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Перевірка статусу відповіді",
