    {
      "name": "📄 Отримати контакт за ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Перевірка статусу відповіді",
              "pm.test('Статус код має бути 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Перевірка структури контакту",
              "pm.test('Контакт має всі обовязкові поля', function () {",
              "    if (pm.response.code === 200) {",
              "        const contact = pm.response.json();",
              "        pm.expect(contact).to.have.property('id');",
              "        pm.expect(contact).to.have.property('name');",
              "        pm.expect(contact).to.have.property('email');",
              "        pm.expect(contact).to.have.property('phone');",
              "    }",
              "});",
              "",
              "// Перевірка валідності email",
              "pm.test('Email має валідний формат', function () {",
              "    const contact = pm.response.json();",
              "    pm.expect(contact.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/);",
              "});",
              "",
              "// Перевірка формату телефону E.164",
              "pm.test('Телефон у форматі E.164', function () {",
              "    const contact = pm.response.json();",
              "    pm.expect(contact.phone).to.match(/^\\+[1-9]\\d{6,14}$/);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
