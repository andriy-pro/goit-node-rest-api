    {
      "name": "📋 Отримати всі контакти",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Перевірка статусу відповіді",
              "pm.test('Статус код має бути 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Перевірка типу контенту",
              "pm.test('Відповідь має бути у форматі JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "",
              "// Перевірка CORS заголовків",
              "pm.test('CORS заголовки присутні', function () {",
              "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.exist;",
              "});",
              "",
              "// Перевірка структури відповіді",
              "pm.test('Відповідь має бути масивом', function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.be.an('array');",
              "});",
              "",
              "// Збереження першого контакту для подальших тестів",
              "if (pm.response.json().length > 0) {",
              "    pm.environment.set('testContactId', pm.response.json()[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
