    {
      "name": "➕ Створити новий контакт",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Перевірка статусу відповіді",
              "pm.test('Статус код має бути 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// Перевірка створення контакту",
              "pm.test('Контакт створено з ID', function () {",
              "    const contact = pm.response.json();",
              "    pm.expect(contact).to.have.property('id');",
              "    pm.expect(contact.id).to.be.a('string');",
              "    pm.expect(contact.id.length).to.be.above(10);",
              "});",
              "",
              "// Перевірка збереження даних",
              "pm.test('Дані контакту збережено правильно', function () {",
              "    const contact = pm.response.json();",
              "    pm.expect(contact.name).to.eql('Тестовий Контакт');",
              "    pm.expect(contact.email).to.eql('test@example.com');",
              "    pm.expect(contact.phone).to.eql('+380501234567');",
              "});",
              "",
              "// Збереження ID для подальших тестів",
              "if (pm.response.json().id) {",
              "    pm.environment.set('createdContactId', pm.response.json().id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
